{
  "uid": "homelab-host",
  "title": "Homelab host metrics",
  "tags": ["homelab"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"homelab\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU used"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory used",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{host=\"homelab\"} / node_memory_MemTotal_bytes{host=\"homelab\"})",
          "legendFormat": "Memory used"
        }
      ]
    },
    {
      "id": 3,
      "title": "Filesystem used (available to non-root)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{host=\"homelab\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|fuse.*\"} / node_filesystem_size_bytes{host=\"homelab\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|fuse.*\"})",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Load average",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } },
      "targets": [
        { "refId": "A", "expr": "node_load1{host=\"homelab\"}", "legendFormat": "1 minute" },
        { "refId": "B", "expr": "node_load5{host=\"homelab\"}", "legendFormat": "5 minutes" },
        { "refId": "C", "expr": "node_load15{host=\"homelab\"}", "legendFormat": "15 minutes" }
      ]
    },
    {
      "id": 5,
      "title": "Network traffic",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{host=\"homelab\",device!=\"lo\"}[$__rate_interval])",
          "legendFormat": "{{device}} receive"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{host=\"homelab\",device!=\"lo\"}[$__rate_interval])",
          "legendFormat": "{{device}} transmit"
        }
      ]
    },
    {
      "id": 6,
      "title": "Scrape target health (1 = up)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "up{host=\"homelab\"}", "legendFormat": "{{job}}", "instant": true }
      ]
    }
  ]
}
